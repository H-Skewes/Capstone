/* This is the second stored procedure file to help us convert
our known stored procedures to the mssql syntax. As well to test anything,
when finished the old file will be deleted and this will be 
known as Stored Procedures.*/

CREATE OR ALTER PROCEDURE dbo.Create_Ticket
   @Ticket_ID INT,
   @Date_Time VARCHAR(25),
   @Ticket_Status VARCHAR(10),
   @Review_Process VARCHAR (25)
AS
BEGIN
    --SET NOCOUNT ON; <-- We want to see the extra results in testing
    INSERT INTO dbo.Dashboard_Main
    (
        Ticket_ID,
        Date_Time,
        Ticket_Status,
        Review_Process
    )
    
    VALUES
    (
        '1+1', -- We will want to add 1 to the previously created ticket number to make it increasing
        GETDATE(),
        'Open',
        'Under Review'
    );
    END;
    GO